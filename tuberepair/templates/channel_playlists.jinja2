<?xml version='1.0' encoding='UTF-8'?>
<feed
    xmlns='http://www.w3.org/2005/Atom'
    xmlns:media='http://search.yahoo.com/mrss/'
    xmlns:openSearch='http://a9.com/-/spec/opensearchrss/1.0/'
    xmlns:gd='http://schemas.google.com/g/2005'
    xmlns:yt='http://gdata.youtube.com/schemas/2007'>
    <id>{{url}}/feeds/api/users/{{channel_id}}/playlists</id>
    <updated>2011-12-27T20:32:10.466Z</updated>
    <category scheme='http://schemas.google.com/g/2005#kind' term='http://gdata.youtube.com/schemas/2007#playlistLink'/>
    <title type='text'>Playlists</title>
    <logo>http://www.youtube.com/img/pic_youtubelogo_123x63.gif</logo>
    <link rel='related' type='application/atom+xml' href='{{url}}/feeds/api/users/{{channel_id}}'/>
    <link rel='alternate' type='text/html' href='{{url}}/'/>
    <link rel='http://schemas.google.com/g/2005#feed' type='application/atom+xml' href='{{url}}/feeds/api/users/{{channel_id}}/playlists'/>
    <link rel='http://schemas.google.com/g/2005#batch' type='application/atom+xml' href='{{url}}/feeds/api/users/{{channel_id}}/playlists/batch'/>
    <link rel='self' type='application/atom+xml' href='{{url}}/feeds/api/users/{{channel_id}}/playlists?start-index=1&amp;max-results=25'/>
    {% if continuation  %}
        <link rel='next' type='application/atom+xml' href='{{url}}/feeds/api/users/{{channel_id}}/playlists?continuation={{continuation}}'/>
    {% endif %}
    {% if next_page %}
        <link rel='next' type='application/atom+xml' href='{{next_page}}'/>
    {% endif %}
    <author>
        <name>{{channel_id}}</name>
        <uri>{{url}}/feeds/api/users/{{channel_id}}</uri>
    </author>
    <generator version='2.1' uri='{{url}}/'>TubeFixer API v2</generator>
    <openSearch:totalResults>{{ data | length }}</openSearch:totalResults>
    <openSearch:startIndex>1</openSearch:startIndex>
    <openSearch:itemsPerPage>{{ data | length }}</openSearch:itemsPerPage>
{% if data %}
    {% for playlist in data %}
        <entry>
            <id>{{url}}/feeds/api/users/{{channel_id}}/playlists/{{playlist['playlistId']}}</id>
            <published>2011-12-19T22:02:40.000Z</published>
            <updated>2011-12-27T18:33:18.000Z</updated>
            <category scheme='http://schemas.google.com/g/2005#kind' term='http://gdata.youtube.com/schemas/2007#playlistLink'/>
            <title type='text'>{{playlist['title']}}</title>
            <content type="application/atom+xml" src="{{ url }}/feeds/api/playlists/{{ playlist['playlistId'] }}"/>
            <link rel='related' type='application/atom+xml' href='{{url}}/feeds/api/users/{{channel_id}}'/>
            <link rel='alternate' type='text/html' href="{{url}}/feeds/api/playlists/{{playlist['playlistId']}}"/>
            <link rel='self' type='application/atom+xml' href="{{url}}/feeds/api/users/{{channel_id}}/playlists/{{playlist['playlistId']}}"/>
            <link rel='edit' type='application/atom+xml' href="{{url}}/feeds/api/playlists/{{playlist['playlistId']}}"/>
            <author>
                <name>{{playlist['author']}}</name>
                <uri>{{url}}/feeds/api/users/{{channel_id}}</uri>
            </author>
            <yt:description>{{playlist.get('description', '')}}</yt:description>
            <subtitle>{{playlist.get('description', '')}}</subtitle>
            <summary>{{playlist.get('description', '')}}</summary>
            <media:group>
                <media:thumbnail
                    url="{{ playlist.get('playlistThumbnail') or 'http://www.youtube.com/img/pic_youtubelogo_123x63.gif' }}"
                    height="90"
                    width="120"
                    yt:name="default"/>
            </media:group>
            <yt:countHint>{{playlist.get('videoCount', 0)}}</yt:countHint>
            <yt:playlistId>{{playlist['playlistId']}}</yt:playlistId>
        </entry>
    {% endfor %}
{% endif %}

</feed>
