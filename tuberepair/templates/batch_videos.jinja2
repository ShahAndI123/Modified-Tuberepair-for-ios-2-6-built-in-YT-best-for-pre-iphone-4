<?xml version='1.0' encoding='UTF-8'?>
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:gd="http://schemas.google.com/g/2005" xmlns:batch="http://schemas.google.com/gdata/batch" xmlns:openSearch="http://a9.com/-/spec/opensearch/1.1/" xmlns:yt="http://gdata.youtube.com/schemas/2007" xmlns:media="http://search.yahoo.com/mrss/" gd:etag="">
  <id>{{ url }}/feeds/api/videos/batch</id>
  <updated>{{ unix(0) }}</updated>
  <title>Batch Feed</title>
<openSearch:totalResults>{{ data | length }}</openSearch:totalResults>
  <openSearch:itemsPerPage>{{ data | length }}</openSearch:itemsPerPage>
  <openSearch:startIndex>1</openSearch:startIndex>

{% for video in data %}
  <entry gd:etag="geQ3cverb8elIZNEapXqfu2pOIY">
    <batch:id>{{ video['videoId'] }}</batch:id>
    <batch:status code="200" reason="Success"/>
    <batch:operation type="query"/>
    <id>tag:youtube.com,2008:video:{{ video['videoId'] }}</id>
    <published>{{ unix(video['published']) }}</published>
    <updated>{{ unix(video['published']) }}</updated>
    <category scheme="http://schemas.google.com/g/2005#kind" term="http://gdata.youtube.com/schemas/2007#video" />
    <category scheme="http://gdata.youtube.com/schemas/2007/categories.cat" term="Music" label="Music" />
    <title>{{ video['title'] }}</title>
    <content type="video/mp4" src="{{ url }}/video/sd/{{ video['videoId'] }}" />
    <link rel="alternate" type="text/html" href="https://www.youtube.com/watch?v={{ video['videoId'] }}&amp;feature=youtube_gdata" />
    <link rel="http://gdata.youtube.com/schemas/2007#video.related" type="application/atom+xml" href="{{ url }}/feeds/api/videos/{{ video['videoId'] }}/related" />
    {% if video['authorId'] != "unknown" and video['authorId'] != "Unknown" %}
    <link rel="http://gdata.youtube.com/schemas/2007#uploader" type="application/atom+xml" href="{{ url }}/feeds/api/users/{{ video['authorId'] }}/uploads" />
    {% endif %}
    <link rel="self" type="application/atom+xml" href="{{ url }}/feeds/api/videos/{{ video['videoId'] }}" />
    <author>
      <n>{{ video['author'] }}</n>
      <uri>{{ url }}/feeds/api/users/{{ video['authorId'] }}/uploads</uri>
      <yt:userId>{{ video['authorId'] }}</yt:userId>
    </author>
    <yt:accessControl action="comment" permission="allowed" />
    <yt:accessControl action="rate" permission="allowed" />
    <yt:accessControl action="embed" permission="allowed" />
    <yt:accessControl action="list" permission="allowed" />
    <yt:accessControl action="autoPlay" permission="allowed" />
    <yt:accessControl action="syndicate" permission="allowed" />
    <gd:comments><gd:feedLink href="{{ url }}/api/videos/{{ video['videoId'] }}/comments"/></gd:comments>
    <yt:statistics favoriteCount="0" viewCount="{{ [video['viewCount'], 2147483647] | min }}" />
    <yt:rating numDislikes="0" numLikes="0" />
    <media:group>
      <media:category label="Music" scheme="http://gdata.youtube.com/schemas/2007/categories.cat">Music</media:category>
      <media:content url="{{ url }}/getvideo/{{ video['videoId'] }}" type="video/mp4" medium="video" isDefault="true" expression="full" duration="{{ video['lengthSeconds'] }}" yt:format="3" />
      <media:content url="{{ url }}/getvideo/{{ video['videoId'] }}" type="video/mp4" medium="video" expression="full" duration="{{ video['lengthSeconds'] }}" yt:format="8" />
      <media:credit role="uploader" scheme="urn:youtube" yt:display="{{ video['author'] }}">{{ video['authorId'] }}</media:credit>
      <media:description type="plain">By {{ video['author'] }} - {{ video['title'] }}</media:description>
      <media:keywords></media:keywords>
      <media:license type="text/html" href="http://www.youtube.com/t/terms">youtube</media:license>
      <media:player url="{{ url }}/getvideo/{{ video['videoId'] }}" />
      <media:thumbnail url="{{ url }}/thumb/{{ video['videoId'] }}" height="90" width="120" yt:name="default" />
      <media:thumbnail url="{{ url }}/thumb/{{ video['videoId'] }}" height="360" width="480" yt:name="hqdefault" />
      <media:title type="plain">{{ video['title'] }}</media:title>
      <yt:aspectRatio>widescreen</yt:aspectRatio>
      <yt:duration seconds="{{ video['lengthSeconds'] }}" />
      <yt:uploaded>{{ unix(video['published']) }}</yt:uploaded>
      <yt:uploaderId>{{ video['authorId'] }}</yt:uploaderId>
      <yt:videoid>{{ video['videoId'] }}</yt:videoid>
    </media:group>
  </entry>
{% endfor %}

</feed>
