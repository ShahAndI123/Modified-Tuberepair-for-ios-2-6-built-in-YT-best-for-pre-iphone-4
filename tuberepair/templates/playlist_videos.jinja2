<?xml version='1.0' encoding='UTF-8'?>
<feed
	xmlns='http://www.w3.org/2005/Atom'
	xmlns:gd='http://schemas.google.com/g/2005'
	xmlns:openSearch='http://a9.com/-/spec/opensearch/1.1/'
	xmlns:yt='http://gdata.youtube.com/schemas/2007'
	xmlns:media='http://search.yahoo.com/mrss/' gd:etag='W/&quot;YDwqeyM.&quot;'>
	<id>{{url}}/feeds/api/playlists/{{playlist_id}}</id>
	<updated>2012-08-23T12:33:58.000Z</updated>
	<title>Playlist videos</title>
	<link rel='http://schemas.google.com/g/2005#feed' type='application/atom+xml' href='{{url}}/feeds/api/playlists/{{playlist_id}}'/>
	<link rel='self' type='application/atom+xml' href='{{url}}/feeds/api/playlists/{{playlist_id}}'/>
	{% if next_page %}
		<link rel='next' type='application/atom+xml' href='{{next_page}}'/>
	{% endif %}
	<openSearch:totalResults>{{ data | length }}</openSearch:totalResults>
	<openSearch:startIndex>1</openSearch:startIndex>
	<openSearch:itemsPerPage>{{ data | length }}</openSearch:itemsPerPage>
{% if data %}
	{% for video in data %}
		<entry gd:etag='W/&quot;YDwqeyM.&quot;'>
			<id>tag:youtube.com,2008:playlist:{{playlist_id}}:{{video['videoId']}}</id>
			<published>2012-08-23T12:33:58.000Z</published>
			<updated>2012-08-23T12:33:58.000Z</updated>
			<category scheme='https://schemas.google.com/g/2005#kind' term='http://gdata.youtube.com/schemas/2007#video'/>
			<category scheme='http://gdata.youtube.com/schemas/2007/categories.cat' term='Howto' label='Howto &amp; Style'/>
			<title>{{video['title']}}</title>
			<content type='application/x-shockwave-flash' src="https://www.youtube.com/v/{{video['videoId']}}?version=3&amp;f=playlists&amp;app=youtube_gvideo"/>
			<summary type='text'>{{video['description']}}</summary>
			<link rel='alternate' type='text/html' href="https://www.youtube.com/watch?v={{video['videoId']}}&amp;feature=youtube_gvideo"/>
			<link rel='http://gdata.youtube.com/schemas/2007#video.related' type='application/atom+xml' href="{{url}}/feeds/api/videos/{{video['videoId']}}/related"/>
			<link rel='http://gdata.youtube.com/schemas/2007#mobile' type='text/html' href="https://m.youtube.com/details?v={{video['videoId']}}"/>
			<link rel='http://gdata.youtube.com/schemas/2007#uploader' type='application/atom+xml' href="{{url}}/feeds/api/users/{{video['authorId']}}?v=2"/>
			<link rel='related' type='application/atom+xml' href="{{url}}/feeds/api/videos/{{video['videoId']}}?v=2"/>
			<link rel='self' type='application/atom+xml' href="{{url}}/feeds/api/playlists/{{playlist_id}}"/>
			<link rel='edit' type='application/atom+xml' href="{{url}}/feeds/api/playlists/{{playlist_id}}"/>
			<author>
				<name>{{video['author']}}</name>
				<uri>{{url}}/feeds/api/users/{{video['authorId']}}</uri>
				<yt:userId>{{video['authorId']}}</yt:userId>
			</author>
			<yt:accessControl action='comment' permission='allowed'/>
			<yt:accessControl action='commentVote' permission='allowed'/>
			<yt:accessControl action='videoRespond' permission='moderated'/>
			<yt:accessControl action='rate' permission='allowed'/>
			<yt:accessControl action='embed' permission='allowed'/>
			<yt:accessControl action='list' permission='allowed'/>
			<yt:accessControl action='autoPlay' permission='allowed'/>
			<yt:accessControl action='syndicate' permission='allowed'/>
			<gd:comments>
				<gd:feedLink rel='http://gdata.youtube.com/schemas/2007#comments' href="{{url}}/api/videos/{{video['videoId']}}/comments?v=2" countHint='5'/>
			</gd:comments>
			<yt:location>Paris ,FR</yt:location>
			<media:group>
				<media:category label='Howto &amp; Style' scheme='http://gdata.youtube.com/schemas/2007/categories.cat'>Howto</media:category>
				<media:content url="https://www.youtube.com/v/{{video['videoId']}}?version=3&amp;f=playlists&amp;app=youtube_gvideo" type='application/x-shockwave-flash' medium='video' isDefault='true' expression='full' duration='0' yt:format='5'/>
				<media:content url="{{url}}/{{video['videoId']}}.3gpp" type='video/3gpp' medium='video' expression='full' duration='0' yt:format='1'/>
				<media:content url="{{url}}/{{video['videoId']}}.3gpp" type='video/3gpp' medium='video' expression='full' duration='0' yt:format='6'/>
				<media:credit role='uploader' scheme='urn:youtube' yt:display="{{video['author']}}" yt:type='partner'>{{video['author']}}</media:credit>
				<media:description type='plain'>{{video['description']}}</media:description>
				<media:keywords/>
				<media:license type='text/html' href='https://www.youtube.com/t/terms'>youtube</media:license>
				<media:player url="https://www.youtube.com/watch?v={{video['videoId']}}&amp;feature=youtube_gvideo_player"/>
				<media:thumbnail url="https://i.ytimg.com/vi/{{video['videoId']}}/default.jpg" height='90' width='120' time='00:00:00.000' yt:name='default'/>
				<media:thumbnail url="https://i.ytimg.com/vi/{{video['videoId']}}/mqdefault.jpg" height='180' width='320' yt:name='mqdefault'/>
				<media:thumbnail url="https://i.ytimg.com/vi/{{video['videoId']}}/hqdefault.jpg" height='360' width='480' yt:name='hqdefault'/>
				<media:thumbnail url="https://i.ytimg.com/vi/{{video['videoId']}}/default.jpg" height='90' width='120' time='00:00:00.000' yt:name='start'/>
				<media:thumbnail url="https://i.ytimg.com/vi/{{video['videoId']}}/default.jpg" height='90' width='120' time='00:00:00.000' yt:name='middle'/>
				<media:thumbnail url="https://i.ytimg.com/vi/{{video['videoId']}}/default.jpg" height='90' width='120' time='00:00:00.000' yt:name='end'/>
				<media:content url="{{url}}/getvideo/{{video['videoId']}}" type="video/mp4" medium="video" isDefault="true" expression="full" duration="0" yt:format="3" />
				<media:content url="{{url}}/{{video['videoId']}}.3gpp" type="video/3gpp" medium="video" expression="full" duration="0" yt:format="2" />
				<media:content url="{{url}}/getvideo/{{video['videoId']}}" type="video/mp4" medium="video" expression="full" duration="0" yt:format="8" />
				<media:content url="{{url}}/{{video['videoId']}}.3gpp" type="video/3gpp" medium="video" expression="full" duration="0" yt:format="9" />
				<media:title type='plain'>{{video['title']}}</media:title>
				<yt:duration seconds="{{video['lengthSeconds']}}"/>
				<yt:uploaded>1969-12-31T12:33:58.000Z</yt:uploaded>
				<yt:uploaderId>{{video['authorId']}}</yt:uploaderId>
				<yt:videoid>{{video['videoId']}}</yt:videoid>
			</media:group>
			<gd:rating average='0' max='0' min='0' numRaters='0' rel='https://schemas.google.com/g/2005#overall'/>
			<yt:recorded>1970-01-01</yt:recorded>
			<yt:statistics favoriteCount='0' viewCount="{{ [video.get('viewCount', 0), 2147483647] | min }}"/>
			<yt:rating numDislikes='0' numLikes='0'/>
			<yt:position>{{loop.index}}</yt:position>
		</entry>
	{% endfor %}
{% endif %}
</feed>
